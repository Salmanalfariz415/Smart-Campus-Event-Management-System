# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Alternative: Keep your existing database URL
# DATABASE_URL=your_existing_database_url

# Application Configuration
SECRET_KEY=your_jwt_secret_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual Supabase credentials
# 3. Your Supabase URL looks like: https://xxxxxxxxxxxxx.supabase.co
# 4. Your Service Role Key is found in Project Settings > API
# 5. Your Database URL is found in Project Settings > Database > Connection string > URI